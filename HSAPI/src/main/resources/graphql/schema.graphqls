type Query {
  # health check
  hello: String!

  # categories
  categories: [Category!]!
  category(id: Int!): Category

  # items
  items: [Item!]!
  item(id: String!): Item
  itemsByCategory(categoryId: String): [Item!]!
  itemsByLocation(location: String!): [Item!]!
  lowStockItems: [Item!]!
  searchItems(searchTerm: String!): [Item!]!

  # projects
  projects: [Project!]!
  project(id: String!): Project
  projectsByStatus(status: String!): [Project!]!
  searchProjects(searchTerm: String!): [Project!]!

  # project-item relationships
  projectItems(projectId: String!): [ProjectItem!]!
  itemProjects(itemId: String!): [Project!]!

  # Paginated queries
  itemsPaginated(page: Int = 0, size: Int = 20): ItemPage!
  itemsByCategoryPaginated(
    categoryId: String!
    page: Int = 0
    size: Int = 20
  ): ItemPage!
  itemsByLocationPaginated(
    location: String!
    page: Int = 0
    size: Int = 20
  ): ItemPage!
  lowStockItemsPaginated(page: Int = 0, size: Int = 20): ItemPage!
  searchItemsPaginated(
    searchTerm: String!
    page: Int = 0
    size: Int = 20
  ): ItemPage!

  projectsPaginated(page: Int = 0, size: Int = 20): ProjectPage!
  projectsByStatusPaginated(
    status: String!
    page: Int = 0
    size: Int = 20
  ): ProjectPage!
  searchProjectsPaginated(
    searchTerm: String!
    page: Int = 0
    size: Int = 20
  ): ProjectPage!

  categoriesPaginated(page: Int = 0, size: Int = 20): CategoryPage!

  projectItemsPaginated(page: Int = 0, size: Int = 20): ProjectItemPage!
  projectItemsByProjectPaginated(
    projectId: String!
    page: Int = 0
    size: Int = 20
  ): ProjectItemPage!
  projectItemsByItemPaginated(
    itemId: String!
    page: Int = 0
    size: Int = 20
  ): ProjectItemPage!
}

type Mutation {
  # categories
  createCategory(input: CategoryInput!): MutationResult!
  updateCategory(id: String!, input: CategoryInput!): MutationResult!
  deleteCategory(id: String!): MutationResult!

  # items
  createItem(input: ItemInput!): ItemMutationResult!
  updateItem(id: String!, input: ItemUpdateInput!): ItemMutationResult!
  deleteItem(id: String!): ItemMutationResult!
  adjustItemQuantity(id: String!, quantityChange: Float!): MutationResult!
  moveItem(id: String!, newLocation: String!): MutationResult!

  # projects
  createProject(input: ProjectInput!): ProjectMutationResult!
  updateProject(id: String!, input: ProjectInput!): ProjectMutationResult!
  deleteProject(id: String!): MutationResult!
  updateProjectStatus(id: String!, status: String!): ProjectMutationResult!
  completeProject(id: String!, endDate: String): ProjectMutationResult!

  # project-item relationships
  addItemToProject(input: ProjectItemInput!): MutationResult!
  updateProjectItem(id: String!, quantityUsed: Float!): MutationResult!
  removeItemFromProject(id: String!): MutationResult!
  removeItemFromProjectByIds(
    projectId: String!
    itemId: String!
  ): MutationResult!
}

# Input types
input CategoryInput {
  name: String!
  description: String
}

input ItemInput {
  name: String!
  description: String
  categoryId: String!
  quantity: Float!
  minQuantity: Float
  unitPrice: Float
  amountType: AmountType
  location: String!
  notes: String
}

input ProjectInput {
  name: String!
  description: String
  status: String!
  startDate: String
  endDate: String
}

input ProjectItemInput {
  projectId: String!
  itemId: String!
  quantityUsed: Float!
  item: ItemInput
}

input ItemUpdateInput {
  name: String
  description: String
  categoryId: Int
  quantity: Float
  minQuantity: Float
  unitPrice: Float
  amountType: AmountType
  location: String
  notes: String
}

# Mutation Response types
type MutationResult {
  success: Boolean!
  message: String
}

type ItemMutationResult {
  success: Boolean!
  message: String
  item: Item
}

type ProjectMutationResult {
  success: Boolean!
  message: String
  project: Project
}

# Enums
enum AmountType {
  PERCENT
  COUNT
  VOLUME
}

# type types
type Category {
  id: Int!
  name: String!
  description: String!
}

type Item {
  id: String!
  name: String!
  description: String
  categoryId: Int!
  quantity: Float!
  minQuantity: Float
  unitPrice: Float
  amountType: AmountType!
  location: String!
  notes: String
  createdAt: String!
  updatedAt: String
  category: Category
}

type Project {
  id: String!
  name: String!
  description: String
  status: String!
  startDate: String
  endDate: String
  createdAt: String!
  updatedAt: String
  items: [ProjectItem]
}

type ProjectItem {
  id: String!
  projectId: String!
  itemId: String!
  quantityUsed: Float
  createdAt: String!
}

# Pagination types
type PageInfo {
  totalElements: Int!
  totalPages: Int!
  currentPage: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
}

type ItemPage {
  content: [Item!]!
  pageInfo: PageInfo!
}

type ProjectPage {
  content: [Project!]!
  pageInfo: PageInfo!
}

type CategoryPage {
  content: [Category!]!
  pageInfo: PageInfo!
}

type ProjectItemPage {
  content: [ProjectItem!]!
  pageInfo: PageInfo!
}
